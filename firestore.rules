rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper functions ────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : '';
    }

    function isMember() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) == 'member' ||
         getUserRole(request.auth.uid) == 'Member');
    }

    function isTreasurer() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) == 'treasurer' ||
         getUserRole(request.auth.uid) == 'Treasurer' ||
         getUserRole(request.auth.uid) == 'viceTreasurer' ||
         getUserRole(request.auth.uid) == 'ViceTreasurer' ||
         getUserRole(request.auth.uid) == 'financialSecretary' ||
         getUserRole(request.auth.uid) == 'FinancialSecretary');
    }

    function isPresident() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) == 'president' ||
         getUserRole(request.auth.uid) == 'President' ||
         getUserRole(request.auth.uid) == 'vicePresident' ||
         getUserRole(request.auth.uid) == 'VicePresident');
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) == 'superAdmin' ||
         getUserRole(request.auth.uid) == 'SuperAdmin');
    }

    function isAdminOrTreasurer() {
      return isTreasurer() || isPresident() || isSuperAdmin();
    }

    function isSecretary() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) == 'secretary' ||
         getUserRole(request.auth.uid) == 'Secretary' ||
         getUserRole(request.auth.uid) == 'viceSecretary' ||
         getUserRole(request.auth.uid) == 'ViceSecretary');
    }

    function isPRO() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) == 'publicRelationsOfficer' ||
         getUserRole(request.auth.uid) == 'PublicRelationsOfficer' ||
         getUserRole(request.auth.uid) == 'pro' ||
         getUserRole(request.auth.uid) == 'PRO');
    }

    function isProvost() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) == 'provost' ||
         getUserRole(request.auth.uid) == 'Provost' ||
         getUserRole(request.auth.uid) == 'chief_provost' ||
         getUserRole(request.auth.uid) == 'Chief Provost');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Organizations collection ─────────────────────────
    // Authenticated users can read all organizations.
    // Unauthenticated users (e.g. the register screen) may only read
    // organizations that are active and open for join, so the org list can
    // load before sign-in while cross-tenant data stays isolated.
    function isPublicJoinableOrg() {
      return resource.data.isActive == true &&
        resource.data.openForJoin == true;
    }

    match /organizations/{organizationId} {
      allow read: if isAuthenticated() || isPublicJoinableOrg();
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update: if isAuthenticated() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Branches collection ─────────────────────────────
    match /branches/{branchId} {
      allow read: if true;
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isAdminOrTreasurer() || isSuperAdmin();
    }

    // ── Co-Founder Invitations collection ───────────────
    match /co_founder_invitations/{invitationId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // ── Users collection ────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() ||
        (isOwner(userId) && request.resource.data.role != 'superAdmin');
      allow update: if isSuperAdmin() || isAdminOrTreasurer() || isOwner(userId);
      allow delete: if isSuperAdmin();
    }

    // ── Members collection ──────────────────────────────
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrTreasurer() ||
        (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdminOrTreasurer() ||
        (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.id == request.auth.uid));
      allow delete: if isSuperAdmin();
    }

    // ── Obligations collection ──────────────────────────
    match /obligations/{obligationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdminOrTreasurer() ||
        isProvost() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.memberId == request.auth.uid ||
        (exists(/databases/$(database)/documents/members/$(request.resource.data.memberId)) &&
         get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.userId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        isAdminOrTreasurer() ||
        isProvost() ||
        resource.data.userId == request.auth.uid ||
        resource.data.memberId == request.auth.uid
      );
      allow delete: if isAdminOrTreasurer();
    }

    // ── Penalty Waivers collection ──────────────────────
    match /penalty_waivers/{waiverId} {
      allow read: if isAuthenticated();
      allow create: if isProvost() || isPresident() || isSuperAdmin();
      allow update: if isPresident() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Payments collection ─────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdminOrTreasurer() ||
        request.resource.data.memberId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdminOrTreasurer() ||
        resource.data.memberId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    // ── Expenses collection ─────────────────────────────
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrTreasurer();
      allow update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── Levies collection ───────────────────────────────
    match /levies/{levyId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrTreasurer();
      allow update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── Receipts collection ─────────────────────────────
    match /receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrTreasurer();
      allow update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── Meetings collection ─────────────────────────────
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isPresident() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Announcements collection ────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isPresident() || isPRO() || isSuperAdmin();
      allow delete: if isSecretary() || isPresident() || isPRO() || isSuperAdmin();
    }

    // ── Documents collection ────────────────────────────
    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isPRO() || isSuperAdmin();
      allow delete: if isSuperAdmin() || isPRO();
    }

    // ── Calendar Events collection ──────────────────────
    match /calendar_events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSecretary() || isPRO() || isSuperAdmin();
    }

    // ── Attendance collection ───────────────────────────
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Meeting RSVPs & Excuses collection ───────────────
    match /meeting_rsvps/{rsvpId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (request.resource.data.memberId == request.auth.uid || isSecretary() || isSuperAdmin());
      allow update: if isAuthenticated() &&
        (resource.data.memberId == request.auth.uid || isSecretary() || isSuperAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.memberId == request.auth.uid || isSecretary() || isSuperAdmin());
    }

    // ── Notifications collection ────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdminOrTreasurer() || isSuperAdmin();
    }

    // ── System Settings collection ───────────────────────
    match /system_settings/{settingId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}
