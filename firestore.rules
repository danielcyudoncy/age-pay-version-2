rules_version = '2';

// ===============================================================
// Assumed Data Models
// ===============================================================
//
// Collection: calls
// Document ID: {callId} (e.g. roomId or UUID)
// Fields:
//   - callerId: string (required, max 128 chars, immutable)
//   - receiverId: string (required, max 128 chars, immutable)
//   - organizationId: string (required, max 100 chars, immutable)
//   - status: string (required, ['calling', 'active', 'ended', 'rejected', 'missed'])
//   - id: string (optional, max 128 chars)
//   - branchId: string (optional, max 100 chars)
//   - callerName: string (optional, max 150 chars)
//   - callerRole: string (optional, max 100 chars)
//   - receiverName: string (optional, max 150 chars)
//   - receiverPhone: string (optional, max 50 chars)
//   - callType: string (optional, max 50 chars)
//   - createdAt: timestamp (optional/system-set)
//   - updatedAt: timestamp (optional/system-set)
//   - endedAt: timestamp (optional)
//
// Collection: announcements
// Document ID: {announcementId}
// Fields:
//   - organizationId: string (required)
//   - title: string (required)
//   - body: string (required)
//   - category: string (required)
//   - createdBy: string (required)
//   - targetAudience: string (required)
//   - createdAt: timestamp (required)
//   - updatedAt: timestamp (required)
//   - isPinned: bool (optional)
//   - isScheduled: bool (optional)
//   - scheduledAt: timestamp (optional)
//   - announcementDate: timestamp (optional)
//   - attachments: list (optional)
//   - targetBranchId: string (optional)
//   - targetBranchName: string (optional)
//
// Collection: notifications
// Document ID: {notificationId}
// Fields:
//   - organizationId: string (required)
//   - title: string (required)
//   - body: string (required)
//   - type: string (required, ['levy', 'payment', 'reminder', 'general'])
//   - receivedAt: timestamp (required)
//   - read: bool (optional)
//   - targetUserId: string (optional)
//   - targetRole: string (optional)
//   - targetBranchId: string (optional)
//   - payload: string (optional)
//   - imageUrl: string (optional)
//
// Collection: fiscal_periods
// Document ID: {fiscalPeriodId}
// Fields:
//   - organizationId: string (required)
//   - branchId: string (optional)
//   - title: string (required)
//   - startDate: timestamp (required)
//   - endDate: timestamp (required)
//   - openingBalance: number (required)
//   - openingCashAtBank: number (optional)
//   - openingCashInHand: number (optional)
//   - isActive: bool (optional)
//   - notes: string (optional)
//   - createdBy: string (required)
//   - createdAt: timestamp (required)
//   - updatedAt: timestamp (required)
//
// Collection: national_remittances
// Document ID: {remittanceId}
// Fields:
//   - organizationId: string (required)
//   - branchId: string (optional)
//   - branchName: string (optional)
//   - levyId: string (required)
//   - levyTitle: string (required)
//   - totalCollected: number (required)
//   - amountRemitted: number (required)
//   - unremittedBalance: number (required)
//   - remittedAt: timestamp (optional)
//   - remittedBy: string (optional)
//   - recipientRef: string (optional)
//   - notes: string (optional)
//   - createdBy: string (required)
//   - createdAt: timestamp (required)
//   - updatedAt: timestamp (required)
//
// Collection: cash_handovers
// Document ID: {handoverId}
// Fields:
//   - organizationId: string (required)
//   - branchId: string (optional)
//   - branchName: string (optional)
//   - amount: number (required)
//   - handoverDate: timestamp (optional)
//   - financialSecretaryId: string (optional)
//   - financialSecretaryName: string (optional)
//   - treasurerId: string (optional)
//   - treasurerName: string (optional)
//   - witnessName: string (optional)
//   - status: string (required)
//   - notes: string (optional)
//   - bankName: string (optional)
//   - accountNumber: string (optional)
//   - depositSlipRef: string (optional)
//   - acceptedAt: timestamp (optional)
//   - rejectedAt: timestamp (optional)
//   - createdBy: string (required)
//   - createdAt: timestamp (required)
//   - updatedAt: timestamp (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper functions ────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        'role' in get(/databases/$(database)/documents/users/$(uid)).data
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : '';
    }

    function getUserNationalRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        'nationalRole' in get(/databases/$(database)/documents/users/$(uid)).data
        ? get(/databases/$(database)/documents/users/$(uid)).data.nationalRole
        : '';
    }

    function isMember() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) in ['member', 'Member']);
    }

    function isTreasurer() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) in ['treasurer', 'Treasurer', 'viceTreasurer', 'ViceTreasurer', 'financialSecretary', 'FinancialSecretary'] ||
         getUserNationalRole(request.auth.uid) in ['treasurer', 'Treasurer', 'viceTreasurer', 'ViceTreasurer', 'financialSecretary', 'FinancialSecretary']);
    }

    function isPresident() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) in ['president', 'President', 'vicePresident', 'VicePresident'] ||
         getUserNationalRole(request.auth.uid) in ['president', 'President', 'vicePresident', 'VicePresident']);
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == 'danielcyudoncy@gmail.com' ||
         getUserRole(request.auth.uid) in ['superAdmin', 'SuperAdmin'] ||
         getUserNationalRole(request.auth.uid) in ['superAdmin', 'SuperAdmin']);
    }

    function isAdminOrTreasurer() {
      return isTreasurer() || isPresident() || isSuperAdmin();
    }

    function isSecretary() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) in ['secretary', 'Secretary', 'viceSecretary', 'ViceSecretary'] ||
         getUserNationalRole(request.auth.uid) in ['secretary', 'Secretary', 'viceSecretary', 'ViceSecretary']);
    }

    function isPRO() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) in ['publicRelationsOfficer', 'PublicRelationsOfficer', 'public_relations_officer', 'pro', 'PRO'] ||
         getUserNationalRole(request.auth.uid) in ['publicRelationsOfficer', 'PublicRelationsOfficer', 'public_relations_officer', 'pro', 'PRO']);
    }

    function isProvost() {
      return isAuthenticated() &&
        (getUserRole(request.auth.uid) in ['provost', 'Provost', 'chief_provost', 'Chief Provost'] ||
         getUserNationalRole(request.auth.uid) in ['provost', 'Provost', 'chief_provost', 'Chief Provost']);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Call session validation
    function isValidCall(data) {
      return ('callerId' in data) && data.callerId is string && data.callerId.size() > 0 && data.callerId.size() <= 128 &&
             ('receiverId' in data) && data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128 &&
             ('organizationId' in data) && data.organizationId is string && data.organizationId.size() > 0 && data.organizationId.size() <= 100 &&
             ('status' in data) && data.status is string && data.status in ['calling', 'active', 'ended', 'rejected', 'missed'] &&
             (!('callerName' in data) || (data.callerName is string && data.callerName.size() <= 150)) &&
             (!('receiverName' in data) || (data.receiverName is string && data.receiverName.size() <= 150)) &&
             (!('callerRole' in data) || (data.callerRole is string && data.callerRole.size() <= 100)) &&
             (!('callType' in data) || (data.callType is string && data.callType.size() <= 50)) &&
             (!('branchId' in data) || (data.branchId is string && data.branchId.size() <= 100)) &&
             (!('receiverPhone' in data) || (data.receiverPhone is string && data.receiverPhone.size() <= 50)) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // ── Organizations collection ─────────────────────────
    // Authenticated users can read all organizations.
    // Unauthenticated users (e.g. the register screen) may only read
    // organizations that are active and open for join, so the org list can
    // load before sign-in while cross-tenant data stays isolated.
    function isPublicJoinableOrg() {
      return resource.data.isActive == true &&
        resource.data.openForJoin == true;
    }

    match /organizations/{organizationId} {
      allow read: if isAuthenticated() || isPublicJoinableOrg();
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update: if isAuthenticated() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Branches collection ─────────────────────────────
    match /branches/{branchId} {
      allow read: if true;
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if isAdminOrTreasurer() || isSuperAdmin();
    }

    // ── Co-Founder Invitations collection ───────────────
    match /co_founder_invitations/{invitationId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // ── Users collection ────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() ||
        (isOwner(userId) && request.resource.data.role != 'superAdmin');
      allow update: if isSuperAdmin() || isAdminOrTreasurer() || isOwner(userId);
      allow delete: if isSuperAdmin();
    }

    // ── Members collection ──────────────────────────────
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrTreasurer() ||
        (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdminOrTreasurer() ||
        (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.id == request.auth.uid));
      allow delete: if isSuperAdmin();
    }

    // ── Obligations collection ──────────────────────────
    match /obligations/{obligationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdminOrTreasurer() ||
        isProvost() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.memberId == request.auth.uid ||
        (exists(/databases/$(database)/documents/members/$(request.resource.data.memberId)) &&
         get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.userId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        isAdminOrTreasurer() ||
        isProvost() ||
        resource.data.userId == request.auth.uid ||
        resource.data.memberId == request.auth.uid
      );
      allow delete: if isAdminOrTreasurer();
    }

    // ── Penalty Waivers collection ──────────────────────
    match /penalty_waivers/{waiverId} {
      allow read: if isAuthenticated();
      allow create: if isProvost() || isPresident() || isSuperAdmin();
      allow update: if isPresident() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Payments collection ─────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdminOrTreasurer() ||
        request.resource.data.memberId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdminOrTreasurer() ||
        resource.data.memberId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    // ── Expenses collection ─────────────────────────────
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrTreasurer();
      allow update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── Levies collection ───────────────────────────────
    match /levies/{levyId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrTreasurer();
      allow update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── Receipts collection ─────────────────────────────
    match /receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrTreasurer();
      allow update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── Fiscal Periods collection ───────────────────────
    match /fiscal_periods/{fiscalPeriodId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── National Remittances collection ─────────────────
    match /national_remittances/{remittanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── Cash Handovers collection ───────────────────────
    match /cash_handovers/{handoverId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrTreasurer();
      allow delete: if isSuperAdmin();
    }

    // ── Meetings collection ─────────────────────────────
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isPresident() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Announcements collection ────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isPresident() || isPRO() || isSuperAdmin();
      allow delete: if isSecretary() || isPresident() || isPRO() || isSuperAdmin();
    }

    // ── Documents collection ────────────────────────────
    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isPRO() || isSuperAdmin();
      allow delete: if isSuperAdmin() || isPRO();
    }

    // ── Calendar Events collection ──────────────────────
    match /calendar_events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSecretary() || isPRO() || isSuperAdmin();
    }

    // ── Attendance collection ───────────────────────────
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Meeting RSVPs & Excuses collection ───────────────
    match /meeting_rsvps/{rsvpId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (request.resource.data.memberId == request.auth.uid || isSecretary() || isSuperAdmin());
      allow update: if isAuthenticated() &&
        (resource.data.memberId == request.auth.uid || isSecretary() || isSuperAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.memberId == request.auth.uid || isSecretary() || isSuperAdmin());
    }

    // ── Notifications collection ────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if (isAuthenticated() && 'targetUserId' in resource.data && resource.data.targetUserId == request.auth.uid) ||
        isAdminOrTreasurer() || isSuperAdmin();
    }

    // ── Calls collection ────────────────────────────────
    match /calls/{callId} {
      allow read: if isAuthenticated() &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid ||
         isSuperAdmin());
      allow create: if isAuthenticated() &&
        isValidCall(request.resource.data) &&
        (request.resource.data.callerId == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() &&
        isValidCall(request.resource.data) &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid ||
         isSuperAdmin()) &&
        (isSuperAdmin() || (
          request.resource.data.callerId == resource.data.callerId &&
          request.resource.data.receiverId == resource.data.receiverId &&
          request.resource.data.organizationId == resource.data.organizationId
        ));
      allow delete: if isSuperAdmin();
    }

    // ── System Settings collection ───────────────────────
    match /system_settings/{settingId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}
